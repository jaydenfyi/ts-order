{
	"name": "ts-order",
	"type": "module",
	"version": "0.0.6",
	"description": "Type-safe Order utility for declarative, composable, and immutable multi-key ordering logic",
	"author": {
		"name": "jaydenfyi",
		"url": "https://github.com/jaydenfyi"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaydenfyi/ts-order.git"
	},
	"sideEffects": [
		"./dist/compile.js",
		"./dist/compile.cjs"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./comparator": {
			"import": "./dist/comparator/index.js",
			"require": "./dist/comparator/index.cjs"
		},
		"./compile": {
			"import": "./dist/compile.js",
			"require": "./dist/compile.cjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"typesVersions": {
		"*": {
			"comparator": [
				"dist/comparator/index.d.ts"
			],
			"compile": [
				"dist/compile.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsdown --format esm --format cjs",
		"test": "vitest run",
		"test:compile": "vitest run --config vitest.compile.config.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bench": "bun run build && tsx benchmarks/run.ts",
		"bench:full": "bun run bench --full",
		"bench:snapshot": "bun run bench:full",
		"bench:quick": "bun run bench",
		"bench:check": "bun run build && tsc -p benchmarks/tsconfig.json && vitest run --config benchmarks/vitest.config.ts",
		"bench:complex": "bun run build && tsx benchmarks/complex-run.ts",
		"bench:sizes": "bun run build && tsx benchmarks/sizes.ts",
		"size": "size-limit",
		"smoke-test": "sh scripts/smoke-test.sh",
		"prettier": "prettier --write .",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"typecheck": "tsc -p . --noEmit",
		"lint:package": "publint && attw --pack .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "bun run build && changeset publish"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^6.0.0",
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^2.29.7",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@types/lodash-es": "4.17.12",
		"@types/node": "^24.8.1",
		"@vitest/coverage-v8": "^5.1.0",
		"effect": "4.1.4",
		"es-toolkit": "1.53.2",
		"esbuild": "0.28.2",
		"eslint": "^9.37.0",
		"fast-check": "^4.10.2",
		"fast-sort": "3.4.1",
		"lodash-es": "4.18.1",
		"prettier": "^3.6.2",
		"publint": "^0.3.25",
		"radashi": "13.1.0",
		"remeda": "2.62.2",
		"size-limit": "^14.3.0",
		"thenby": "1.4.1",
		"tinybench": "6.2.4",
		"tsdown": "^0.15.7",
		"tsx": "4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
